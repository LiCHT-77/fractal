{
  "name": "@licht-77/fractal",
  "version": "0.0.5",
  "type": "module",
  "description": "A type-safe JSON-RPC framework",
  "license": "MIT",
  "author": "LiCHT-77",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiCHT-77/fractal.git"
  },
  "keywords": [
    "json-rpc",
    "rpc",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./endpoint": {
      "types": "./dist/endpoint/index.d.ts",
      "import": "./dist/endpoint/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter/index.d.ts",
      "import": "./dist/adapter/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && bun run build:js && bun run build:types",
    "build:js": "bun build src/index.ts src/endpoint/index.ts src/adapter/index.ts src/client/index.ts --outdir dist --root src --splitting --format esm --target node",
    "build:types": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/bun": "latest",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
